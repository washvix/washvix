# Washvix Backend Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Admin authentication (use a long random AUTH_SECRET in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
AUTH_SECRET=replace-with-a-long-random-secret

# Email Configuration (for booking notifications)
# Using Gmail SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@washvix.com
ADMIN_EMAIL=washvix@gmail.com

# Twilio Configuration (for SMS notifications)
# Get these from https://www.twilio.com/console
TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1234567890

# Business Settings
BUSINESS_NAME=Washvix
BUSINESS_EMAIL=info@washvix.com
BUSINESS_PHONE=+91-XXXXXXXXXX

# Database Settings (for future upgrades)
# DB_HOST=localhost
# DB_PORT=27017
# DB_NAME=washvix
# DB_USER=admin
# DB_PASSWORD=password
